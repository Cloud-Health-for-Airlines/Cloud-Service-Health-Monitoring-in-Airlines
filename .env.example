# BACCP Environment Configuration Template
# Copy this file to .env and adjust values as required.
# DO NOT commit real secrets or credentials to version control.

# ==============================================================================
# Cloud Deployment Mode
# Options: 'local' (simulated mock mode without AWS credentials) or 'aws' (live AWS integration)
# ==============================================================================
CLOUD_MODE=local

# ==============================================================================
# AWS Core Configuration
# Used when CLOUD_MODE=aws
# ==============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ==============================================================================
# Amazon CloudWatch Metrics
# Namespace for boundary sync drift, cascade probabilities, and mitigation telemetry
# ==============================================================================
CLOUDWATCH_NAMESPACE=BACCP/AirlineCloudHealth

# ==============================================================================
# AWS X-Ray Tracing
# Set to 'true' to emit UDP trace segments to the AWS X-Ray daemon
# ==============================================================================
X_RAY_ENABLED=false
AWS_XRAY_DAEMON_ADDRESS=127.0.0.1:2000

# ==============================================================================
# Amazon SageMaker Endpoint
# Endpoint name hosting the Relational Graph Convolutional Network (RGCN) cascade model
# ==============================================================================
AWS_SAGEMAKER_ENDPOINT=baccp-cascade-predictor

# ==============================================================================
# AWS Lambda Circuit Breaker
# Function name invoked for boundary rate-limiting and automated circuit breaking
# ==============================================================================
AWS_LAMBDA_FUNCTION_NAME=baccp-circuit-breaker-mitigator

# ==============================================================================
# Amazon SNS Topic
# Topic ARN for high-severity predictive cascade alerts and operator notifications
# ==============================================================================
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:baccp-cascade-alerts

# ==============================================================================
# BACCP Local Backend Server Configuration
# ==============================================================================
BACCP_HOST=0.0.0.0
BACCP_PORT=8000
SYNC_DRIFT_THRESHOLD=45.0
CASCADE_RISK_THRESHOLD=0.65
DATABASE_URL=postgresql://baccp:baccp-local@127.0.0.1:5432/baccp
